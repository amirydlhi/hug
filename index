<!DOCTYPE html>
<html lang="en" dir="ltr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Some things are better unfolded</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..500;1,6..72,300..500&family=Inter:wght@400;500;600&family=Vazirmatn:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#f8f6f2;--bg2:#f5eceb;--ink:#2a2724;--muted:#7b716c;--pink:#d9779a;--line:rgba(217,119,154,.24);--hair:rgba(122,110,104,.34);color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1f1a1c;--bg2:#2a2024;--ink:#f4ece8;--muted:#b3a5a1;--pink:#f08fb0;--line:rgba(240,143,176,.26);--hair:rgba(190,170,165,.4);color-scheme:dark}}
:root[data-theme="dark"]{--bg:#1f1a1c;--bg2:#2a2024;--ink:#f4ece8;--muted:#b3a5a1;--pink:#f08fb0;--line:rgba(240,143,176,.26);--hair:rgba(190,170,165,.4);color-scheme:dark}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,"Segoe UI",Roboto,sans-serif;overflow-x:hidden}
.serif{font-family:Newsreader,Georgia,"Times New Roman",serif}
.track{height:420vh;position:relative}
.hero{position:sticky;top:0;height:100vh;height:100dvh;overflow:hidden;background:linear-gradient(100deg,var(--bg2) 0%,var(--bg) 58%)}
.ring{position:absolute;border:1px solid var(--line);border-radius:50%;pointer-events:none}
.r1{width:min(44vw,640px);aspect-ratio:1;left:-9vw;top:2%}
.r2{width:min(40vw,560px);aspect-ratio:1;right:-9vw;bottom:-14%}
.copy{position:absolute;left:clamp(22px,5.5vw,110px);top:clamp(70px,17vh,170px);width:min(33vw,460px);z-index:2}
.eyebrow{margin:0 0 22px;font-size:12.5px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--pink)}
h1{margin:0 0 26px;font-family:Newsreader,Georgia,"Times New Roman",serif;font-weight:400;font-size:clamp(40px,5.4vw,86px);line-height:.98;letter-spacing:-.025em}
h1 em{color:var(--pink);font-style:italic}
.fa{margin:0;max-width:270px;font-family:Vazirmatn,Tahoma,sans-serif;direction:rtl;text-align:left;font-size:15px;line-height:1.9;color:var(--muted)}
.char{position:absolute;left:58%;top:50%;width:min(40vw,70vh,70dvh);aspect-ratio:760/820;transform:translate(-50%,-50%);filter:drop-shadow(0 22px 26px rgba(90,40,50,.22))}
.char img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;opacity:0;will-change:opacity,transform;user-select:none;-webkit-user-drag:none}
.cap{position:absolute;right:clamp(24px,8vw,150px);top:62%;width:176px;z-index:2;color:var(--muted)}
.cap svg{display:block;margin-bottom:12px;color:var(--pink)}
.cap p{margin:0;font-family:Newsreader,Georgia,serif;font-size:16px;line-height:1.5;transform:rotate(2deg)}
.scroll{position:absolute;left:clamp(22px,5.5vw,105px);bottom:clamp(24px,6vh,64px);display:flex;align-items:center;gap:16px;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
.mouse{position:relative;width:34px;height:46px;border:1px solid var(--hair);border-radius:17px}
.mouse::after{content:"";position:absolute;left:50%;top:10px;width:2px;height:8px;border-radius:1px;background:var(--pink);transform:translateX(-50%)}
.meter{position:absolute;right:clamp(24px,8vw,150px);bottom:clamp(24px,6vh,64px);display:flex;align-items:center;gap:16px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.meter .line{position:relative;width:min(14vw,188px);height:1px;background:var(--hair)}
.meter .line i{position:absolute;inset:0;background:var(--pink);transform-origin:left;transform:scaleX(0)}
.snd{position:absolute;top:clamp(16px,3vh,32px);right:clamp(16px,3vw,40px);z-index:3;border:1px solid var(--hair);border-radius:999px;padding:8px 14px;background:transparent;color:var(--ink);font:inherit;font-size:12px;letter-spacing:.1em;cursor:pointer}
.snd:focus-visible,.again:focus-visible{outline:3px solid var(--pink);outline-offset:3px}
.note{position:relative;min-height:100vh;min-height:100dvh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:12vh 24px;background:var(--bg);border-top:1px solid var(--hair)}
.note .eyebrow{color:var(--muted)}
.note h2{margin:0;max-width:min(88vw,820px);font-family:Newsreader,Georgia,serif;font-weight:400;font-size:clamp(40px,6.2vw,92px);line-height:1.04;letter-spacing:-.02em}
.note h2 em{color:var(--pink)}
.note .body{max-width:420px;margin:34px 0 22px;color:var(--muted);font-size:16px;line-height:2}
.sig{margin:0 0 34px;font-family:Newsreader,Georgia,serif;font-style:italic;font-size:28px;color:var(--pink)}
.again{border:1px solid var(--hair);border-radius:999px;padding:16px 26px;background:transparent;color:var(--ink);font:inherit;font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;cursor:pointer}
@media (max-width:820px){
 .copy{top:clamp(56px,8vh,90px);width:calc(100vw - 44px)}
 h1{font-size:clamp(32px,9.5vw,46px);margin-bottom:14px}
 .eyebrow{margin-bottom:14px}
 .fa{font-size:14px;max-width:none}
 .char{left:50%;top:62%;width:min(98vw,52vh,52dvh)}
 .cap,.scroll{display:none}
 .meter{left:22px;right:22px;justify-content:space-between}
 .meter .line{flex:1;width:auto}
 .r1{width:80vw;left:-30vw}
}
</style></head><body>
<div class="track" id="track"><section class="hero">
<div class="ring r1"></div><div class="ring r2"></div>
<button class="snd" id="snd" aria-pressed="true">🔈 Tap for sound</button>
<div class="copy">
 <p class="eyebrow">A small reminder</p>
 <h1>Some things are better <em>unfolded.</em></h1>
 <p class="fa" lang="fa">آهسته اسکرول کن؛ این یادداشت کوچک کم‌کم باز می‌شود.</p>
</div>
<div class="char" id="char" role="img" aria-label="A tiny paper person that unfolds as you scroll"></div>
<div class="cap"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg><p>a tiny paper person, carrying a very big wish.</p></div>
<div class="scroll"><span class="mouse"></span><span>Scroll to unfold</span></div>
<div class="meter"><span id="pct">0%</span><span class="line"><i id="fill"></i></span><span id="state">01 — Folded</span></div>
</section></div>
<section class="note" id="note">
 <p class="eyebrow">A note for you</p>
 <h2>May life be <em>gentle</em> with you.</h2>
 <p class="body">I hope you find small reasons to smile, soft moments to breathe, and people who remind you that you matter.</p>
 <p class="sig">with care, ♡</p>
 <button class="again" id="again">Watch it unfold again ↗</button>
</section>
<script>
const FRAMES=["data:image/webp;base64,", "data:image/webp;base64,", "data:image/webp;base64,", "data:image/webp;base64,", "data:image/webp;base64,", "data:image/webp;base64,"];
const AB64="";
const box=document.getElementById('char'),track=document.getElementById('track');
const fill=document.getElementById('fill'),pctEl=document.getElementById('pct'),stateEl=document.getElementById('state');
const imgs=FRAMES.map(s=>{const i=new Image();i.decoding='sync';i.src=s;i.draggable=false;i.alt='';box.appendChild(i);return i});
imgs[0].style.opacity=1;
const N=FRAMES.length,ease=t=>t*t*(3-2*t);
const NAMES=['01 — Folded','02 — Opening','03 — Arms wide','04 — Unfolded'];
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
let target=0,cur=0,lastName='';
function readScroll(){
  const r=track.getBoundingClientRect(),max=track.offsetHeight-innerHeight;
  const p=max>1?-r.top/max:0;
  target=Number.isFinite(p)?Math.min(1,Math.max(0,p)):0;
}
addEventListener('scroll',readScroll,{passive:true});addEventListener('resize',readScroll);addEventListener('load',readScroll);
if('ResizeObserver' in window)new ResizeObserver(readScroll).observe(document.body);

/* ---- sound: Web Audio, a fresh source each time so it replays every time ---- */
const snd=document.getElementById('snd');
let ctx=null,buf=null,soundOn=true,ctxAt=0,played=false;
function b64ToBuf(b){const s=atob(b),u=new Uint8Array(s.length);for(let i=0;i<s.length;i++)u[i]=s.charCodeAt(i);return u.buffer}
function ensureCtx(){
  if(ctx)return ctx;
  try{ctx=new (window.AudioContext||window.webkitAudioContext)();ctxAt=performance.now();
    ctx.decodeAudioData(b64ToBuf(AB64)).then(b=>{buf=b}).catch(()=>{});
    ctx.onstatechange=updateBtn;
  }catch(e){ctx=null}
  return ctx;
}
function running(){return !!ctx&&ctx.state==='running'}
function unlock(){const c=ensureCtx();if(c&&c.state!=='running')c.resume().then(updateBtn).catch(()=>{});updateBtn()}
['pointerdown','touchend','keydown','click'].forEach(e=>addEventListener(e,unlock,{passive:true}));
function updateBtn(){
  snd.textContent=!running()?'🔈 Tap for sound':(soundOn?'🔊 Sound on':'🔇 Sound off');
  snd.setAttribute('aria-pressed',String(soundOn));
}
snd.addEventListener('click',()=>{
  if(running()&&performance.now()-ctxAt>600){soundOn=!soundOn;updateBtn()}
});
function playSound(){
  if(!soundOn||!running()||!buf)return;
  try{const s=ctx.createBufferSource();s.buffer=buf;s.connect(ctx.destination);s.start(0)}catch(e){}
}
function soundCheck(q){
  if(q>=.66&&!played){played=true;playSound()}
  else if(q<.45){played=false}   // going back up re-arms it
}

function draw(p){
  const q=Math.min(1,p/.85),x=q*(N-1),k=Math.min(Math.floor(x),N-2),f=x-k;
  const b=ease(Math.min(1,Math.max(0,(f-.3)/.4)));
  imgs.forEach((im,i)=>{
    let o=0,s=1,ty=0;
    if(i===k){o=1-b;s=1+.015*b;ty=-4*b}
    else if(i===k+1){o=b;s=1.015-.015*b;ty=4-4*b}
    im.style.opacity=o;im.style.transform='translateY('+ty+'px) scale('+s+')';
  });
  fill.style.transform='scaleX('+q+')';
  pctEl.textContent=Math.round(q*100)+'%';
  const nm=NAMES[q<.2?0:q<.5?1:q<.85?2:3];
  if(nm!==lastName){stateEl.textContent=nm;lastName=nm}
  soundCheck(q);
}
function loop(){
  cur+=(target-cur)*(reduce?1:.09);
  if(Math.abs(target-cur)<.0004)cur=target;
  draw(cur);requestAnimationFrame(loop);
}
document.getElementById('again').onclick=()=>{
  const y=track.getBoundingClientRect().top+scrollY;
  scrollTo({top:y,behavior:reduce?'auto':'smooth'});
};
readScroll();cur=target;updateBtn();loop();
</script></body></html>
